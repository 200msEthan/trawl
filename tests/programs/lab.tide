use stdlib
: D -900001 dig ;
: K -900002 dig ;
: TOT -900003 dig ;
: CM -900004 dig ;
: M -900005 dig ;
: f dup K power + D % ;
: land 3 D * [ swap f swap 1 - ] drop ;
: cyclemin dup -900010 bury dup f dup -900010 dig = 0 = [ drop swap over min swap f dup -900010 dig = 0 = ] drop drop ;
: fixed? -900012 bury -900011 bury -900011 dig K power -900012 dig % -900013 bury 1 -900012 dig D / 1 + [ dup 1 - D * -900011 dig + K power -900012 dig % -900013 dig = rot * swap 1 - ] drop ;
: check-r dup -900014 dig fixed? rot * swap ;
: cycle-ok -900014 bury 1 CM check-r f dup CM = 0 = [ drop check-r f dup CM = 0 = ] drop drop ;
: best-M D -900005 bury D K power [ dup D K power swap % 0 = if dup D * cycle-ok if dup D * M max -900005 bury then then 1 - ] drop ;
: add-r dup K power M % rot + swap ;
: cycle-S 0 CM add-r f dup CM = 0 = [ drop add-r f dup CM = 0 = ] drop drop M % ;
: count-cycle best-M cycle-S dup D % 0 = if D / M D / tuck % swap gcd else drop 1 then TOT + -900003 bury ;
: try-r land cyclemin dup 800000 - dig if drop else dup 1 swap 800000 - bury -900004 bury count-cycle then ;
: clear-seen D 1 + [ 0 over 800001 - bury 1 - ] drop ;
: predict -900002 bury 1 - -900001 bury 0 -900003 bury D 1 = if 1 else clear-seen D [ dup 1 - try-r 1 - ] drop TOT then ;
: B -910001 dig ;
: P -910002 dig ;
: LIM -910003 dig ;
: NN -910004 dig ;
: flow dup B digsum P power + ;
: keep-going dup LIM < if dup dig 0 = else 0 then ;
: endpoint keep-going [ drop flow keep-going ] drop ;
: river-id dup endpoint dup LIM < if dig else drop 0 then dup 0 = if drop 0 dig 1 + dup 0 bury then ;
: paint river-id swap keep-going [ drop over over bury flow keep-going ] drop drop drop ;
: observe drain -910003 bury -910004 bury -910002 bury -910001 bury 1 [ dup paint 1 + dup NN > if drop 0 then ] drop 0 dig ;
: blind-test ." base " -920004 bury -920003 bury -920002 bury -920001 bury -920001 dig . ." power " -920002 dig . ." predicted " -920001 dig -920002 dig predict dup . ." observed " -920001 dig -920002 dig -920003 dig -920004 dig observe dup . = if ." MATCH" else ." differs" then 10 emit ;
: safe-test -930003 bury -930002 bury -930001 bury -930001 dig -930002 dig -930001 dig 1 - -930002 dig power 1 + -930003 dig blind-test ;
: track dup endpoint dup LIM < if dup -940001 dig > if -940001 bury dup -940002 bury else drop then else drop then ;
: slowest drain -910003 bury -910004 bury -910002 bury -910001 bury 0 -940001 bury 1 [ dup track dup paint 1 + dup NN > if drop 0 then ] drop -940002 dig -940001 dig ;
