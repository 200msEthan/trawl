# The Tide standard library, written in Tide itself.
: nip swap drop ;
: tuck swap over ;
: sq dup * ;
: abs dup 0 < if 0 swap - then ;
: max over over < if swap then drop ;
: min over over > if swap then drop ;
: even 2 % 0 = ;
: fact dup 2 < if drop 1 else dup 1 - fact * then ;
: fib 0 1 rot [ rot rot swap over + rot 1 - ] drop drop ;
: slow-fib dup 2 < if else dup 1 - slow-fib swap 2 - slow-fib + then ;
: gcd dup 0 = if drop else tuck % gcd then ;
: divides % 0 = ;
: cr 10 emit ;
