# A k=4 family found by a research Claude, Nov 2026: n = 8t^4 - 18t^2 + 6
# A LEAD, NOT A PROOF: it gives k=4 for about 4% of t, which says nothing yet about
# whether there are infinitely many such n.
#   n+1 = (2t^2-1)(4t^2-7)       n+2 = 2(2t^2-t-2)(2t^2+t-2)
#   n+3 = (2t^2-3)(4t^2-3)       n+4 = 2(t-1)(t+1)(4t^2-5)
# usage at bottom:  T0 T1 hunt   -> prints each t with ((n+4)!)^2 | (2n)!, then the count
use judge
: cells -50 bury
  -50 dig dup * -51 bury
  -51 dig 2 * 1 - 5001 bury   -51 dig 4 * 7 - 5002 bury   2 5003 bury
  -51 dig 2 * -50 dig - 2 - 5004 bury   -51 dig 2 * -50 dig + 2 - 5005 bury
  -51 dig 2 * 3 - 5006 bury   -51 dig 4 * 3 - 5007 bury   2 5008 bury
  -50 dig 1 - 5009 bury   -50 dig 1 + 5010 bury   -51 dig 4 * 5 - 5011 bury
  11 -3 bury  -50 dig 2 * 2 + -5 bury ;
: nof dup * dup dup * 8 * swap 18 * - 6 + ;
: hunt -61 bury -60 bury 0 -62 bury
  1 [ drop
    -60 dig cells -60 dig nof judge if -60 dig . -62 dig 1 + -62 bury then
    -60 dig 1 + -60 bury
    -60 dig -61 dig < ] drop
  ." count " -62 dig . ;
