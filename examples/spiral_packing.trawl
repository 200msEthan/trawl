# A402223 (submitted to the OEIS, waiting for review). Walk the square grid in a spiral
# from the center. Each cell gets the smallest k such that no earlier cell within k
# steps (up, down, left, right) already has k.
# (The greedy packing coloring in spiral order.)
#
# Prints the first 100 terms, then each cell where a new largest value first appears.
# The value 32 first appears at cell 3355518; set the cell count below to go further.

: abs dup 0 < if 0 swap - then ;
# addr ( x y -- seabed cell of grid point x, y )
: addr 2000 + swap 2000 + 4001 * + 1000000 + ;

# hit ( -- flag ): does a cell within k (cell -8) of here (cells -1, -2) already hold k?
: hit
  0 -9 bury
  -8 dig 0 swap - -10 bury
  1 [ drop
    -8 dig -10 dig abs - -12 bury
    -12 dig 0 swap - -11 bury
    1 [ drop
      -1 dig -10 dig + -2 dig -11 dig + addr dig -8 dig = if 1 -9 bury then
      -11 dig 1 + -11 bury
      -11 dig -12 dig > 0 = ] drop
    -10 dig 1 + -10 bury
    -10 dig -8 dig > 0 = ] drop
  -9 dig ;

# record ( k -- ): say where value k first appeared (kept in cell 500 + k)
: record ." value " dup . ." first at cell " 500 + dig . 10 emit ;

# color: give this cell its value; print it among the first 100, and print the cell
# number whenever the value is a new largest
: color
  1 -8 bury
  1 [ drop hit dup if -8 dig 1 + -8 bury then ] drop
  -8 dig -1 dig -2 dig addr bury
  -14 dig 1 + -14 bury
  -8 dig -13 dig > if -8 dig -13 bury -14 dig -8 dig 500 + bury  -14 dig 100 > if -8 dig record then then
  -14 dig 101 < if -8 dig . then
  -14 dig 100 = if 10 emit 1 1 [ drop dup record 1 + dup -13 dig > 0 = ] drop drop then ;

# move one step along the spiral: position (-1, -2), direction (-3, -4),
# steps done in this leg (-6), leg length (-5), legs done at this length (-7)
: move
  -1 dig -3 dig + -1 bury
  -2 dig -4 dig + -2 bury
  -6 dig 1 + -6 bury
  -6 dig -5 dig = if
    0 -6 bury
    -3 dig -4 dig 0 swap - -3 bury -4 bury
    -7 dig 1 + -7 bury
    -7 dig 2 = if 0 -7 bury -5 dig 1 + -5 bury then
  then ;

1 -3 bury 1 -5 bury
3355518 [ color move 1 - ] drop
