# Six queens on a 6x6 board, none attacking another (written by Claude #2 in Tide).
# Worlds: `wave` guesses a row for each column; `want` sinks any world where a queen is attacked.
use stdlib
: n 6 ;
: row 100 dig ;
: col 101 dig ;
: diff row swap dig - abs ;
: ok-with dup diff dup 0 = if drop drop 0 else swap col swap - = if 0 else 1 then then ;
: safe 1 [ dup col < if dup ok-with want 1 + else drop 0 then ] drop ;
: place dup 101 bury 1 n wave 100 bury safe row swap bury ;
1 [ dup place 1 + dup n > if drop 0 then ] drop
: cell dig over = if 81 else 46 then emit 32 emit ;
: line 1 [ swap over cell swap 1 + dup n > if drop 0 then ] drop cr ;
1 [ line 1 + dup n > if drop 0 then ] drop
n . ." queens on the board, and none of them attack each other" cr
