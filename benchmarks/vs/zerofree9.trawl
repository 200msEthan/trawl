# n <= 30000 where 2^n has no digit 0 (OEIS A007377), nine digits at a time
# chunk ( c full -- flag ): are the digits of the small number c free of 0? full: c has all 9 digits
: chunk -6 bury -5 bury 1 -7 bury 9 -8 bury
  1 [ drop
    -5 dig 10 % 0 = if 0 -7 bury then
    -5 dig 10 / -5 bury  -8 dig 1 - -8 bury
    -8 dig 0 >  -6 dig -5 dig 0 > + 0 > *  -7 dig * ] drop
  -7 dig ;
: zerofree -1 bury 1 -2 bury
  1 [ drop
    -1 dig 1000000000 % -1 dig 1000000000 < 0 = chunk -2 dig * -2 bury
    -1 dig 1000000000 / -1 bury
    -1 dig 0 > -2 dig * ] drop
  -2 dig ;
1 -3 bury 1 -4 bury
1 [ drop
  -3 dig 2 * dup -3 bury zerofree if -4 dig . then
  -4 dig 1 + dup -4 bury 30000 > 0 = ] drop
